[Unit]
Description=Masamong school notice collection batch
Documentation=https://github.com/lastdefiance20/Masamong
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/masamong/general.env

[Service]
Type=oneshot
User=masamong
Group=masamong
WorkingDirectory=/srv/masamong/current
Environment=MASAMONG_ENV_FILE=/etc/masamong/general.env
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/masamong/current/venv/bin/python /srv/masamong/current/scripts/run_school_notice_batch.py --core-python /srv/school-notice/venv/bin/python --core-cwd /srv/school-notice --no-llm --low-resource
RuntimeMaxSec=7800
TimeoutStopSec=30
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TasksMax=64
UMask=0077
NoNewPrivileges=true
