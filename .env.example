# ----------------------------------------------------
# 1. 공통 및 기본 API 세팅
# ----------------------------------------------------
# 운영 분리는 profiles/*.env.example과 docs/INSTANCE_SEPARATION.ko.md를 따르세요.
# MASAMONG_PROFILE=general
# MASAMONG_INSTANCE_NAME=general
# MASAMONG_REQUIRE_EXPLICIT_PROFILE=true
# MASAMONG_ENV_FILE=/etc/masamong/general.env
# MASAMONG_CONFIG_FILE=/etc/masamong/general/config.json
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
# 프로필별 최고 관리자. Masamo/General에 서로 다른 Discord 사용자 ID를 지정하세요.
MASAMONG_SUPERADMIN_USER_IDS=

# OpenRouter (텍스트 라우팅·답변 모델)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter가 다른 호스팅 공급자로 우회하지 못하게 OpenAI만 허용합니다.
OPENROUTER_PROVIDER_ONLY=openai
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
# 데이터 수집을 허용하지 않는 endpoint만 선택합니다. 계정 정책과 함께 확인하세요.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_APP_URL=https://github.com/kim0040/masamong
OPENROUTER_APP_TITLE=Masamong

# CometAPI (이미지 생성 전용)
COMETAPI_KEY=your_cometapi_key_here
COMETAPI_BASE_URL=https://api.cometapi.com/v1
USE_COMETAPI=true

# Linkup (웹 검색 엔진)
LINKUP_API_KEY=your_linkup_api_key_here
LINKUP_BASE_URL=https://api.linkup.so/v1
WEB_SEARCH_PROVIDER=linkup
LINKUP_ENABLED=true
LINKUP_TIMEOUT_SECONDS=40
LINKUP_PIPELINE_TIMEOUT_SECONDS=55
WEB_SEARCH_TOTAL_TIMEOUT_SECONDS=60
# 에이전트 기본 권장값: raw source 중심
LINKUP_OUTPUT_TYPE=searchResults
LINKUP_MONTHLY_BUDGET_ENFORCED=true
LINKUP_MONTHLY_BUDGET_USD=4.5
LINKUP_FETCH_RENDER_JS=false
LINKUP_FETCH_JS_RETRY_ENABLED=true
WEB_SEARCH_GLOBAL_RPM_LIMIT=20
WEB_SEARCH_GLOBAL_RPD_LIMIT=1000
WEB_SEARCH_GUILD_RPM_LIMIT=10
WEB_SEARCH_GUILD_RPD_LIMIT=300
WEB_SEARCH_USER_RPM_LIMIT=4
WEB_SEARCH_USER_RPD_LIMIT=60

# 이전 기본 Gemini API 키 (선택 사항)
GEMINI_API_KEY=your_gemini_api_key_here
ALLOW_DIRECT_GEMINI_FALLBACK=false

# ----------------------------------------------------
# 2. Main 레인 (답변 생성 - OpenRouter GPT-5.6 Luna)
# ----------------------------------------------------
LLM_MAIN_PRIMARY_PROVIDER=openai_compat
LLM_MAIN_PRIMARY_MODEL=openai/gpt-5.6-luna
LLM_MAIN_PRIMARY_BASE_URL=${OPENROUTER_BASE_URL}
LLM_MAIN_PRIMARY_API_KEY=${OPENROUTER_API_KEY}
# 같은 routing 호출에서 none/low/high를 정하고 추가 판정 호출은 하지 않습니다.
LLM_DYNAMIC_REASONING_ENABLED=true
LLM_DYNAMIC_REASONING_DEFAULT=none
MAIN_LLM_MAX_TOKENS=8192
MAIN_LLM_LOW_MAX_TOKENS=2048
MAIN_LLM_HIGH_MAX_TOKENS=8192
# 동적 추론을 끈 경우에만 아래 고정값을 사용합니다.
# LLM_MAIN_PRIMARY_REASONING_EFFORT=none

LLM_MAIN_FALLBACK_PROVIDER=none
LLM_MAIN_FALLBACK_MODEL=
LLM_MAIN_FALLBACK_BASE_URL=
LLM_MAIN_FALLBACK_API_KEY=
# LLM_MAIN_FALLBACK_REASONING_EFFORT=
# 논리 호출 1회는 전역·서버/DM·사용자·기능 한도를 모두 통과해야 합니다.
COMETAPI_RPM_LIMIT=40
COMETAPI_RPD_LIMIT=3000
LLM_GUILD_RPM_LIMIT=30
LLM_GUILD_RPD_LIMIT=2000
LLM_DM_RPM_LIMIT=20
LLM_DM_RPD_LIMIT=1000
LLM_USER_RPM_LIMIT=12
LLM_USER_RPD_LIMIT=300
LLM_DM_USER_RPM_LIMIT=8
LLM_DM_USER_RPD_LIMIT=120
LLM_FEATURE_RPM_LIMIT=35
LLM_FEATURE_RPD_LIMIT=2500

# ----------------------------------------------------
# 3. Routing 레인 (웹 검색, 의도 분석 - OpenRouter GPT-5.6 Luna low)
# ----------------------------------------------------
LLM_ROUTING_PRIMARY_PROVIDER=openai_compat
LLM_ROUTING_PRIMARY_MODEL=openai/gpt-5.6-luna
LLM_ROUTING_PRIMARY_BASE_URL=${OPENROUTER_BASE_URL}
LLM_ROUTING_PRIMARY_API_KEY=${OPENROUTER_API_KEY}
LLM_ROUTING_PRIMARY_REASONING_EFFORT=low
INTENT_LLM_ENABLED=true
# 의미 라우터 JSON 전용 출력 상한. 웹 기사 요약용 ROUTING_LLM_MAX_TOKENS와 분리됩니다.
SEMANTIC_ROUTER_MAX_TOKENS=384
SEMANTIC_ROUTER_COMPACTION_MAX_TOKENS=768
# 라우터는 짧은 JSON만 만들므로 메인 응답보다 짧게 제한합니다.
ROUTING_LLM_CALL_TIMEOUT_SECONDS=25
# 최근 원문 8개 + 필요할 때만 앞 구간을 짧은 digest로 압축합니다.
AI_CONTEXT_SOURCE_HISTORY_LIMIT=24
AI_CONTEXT_RECENT_TURNS=8
AI_CONTEXT_COMPACTION_TRIGGER_CHARS=3500
AI_CONTEXT_COMPACTION_SOURCE_MAX_CHARS=5000
AI_CONTEXT_DIGEST_MAX_CHARS=600
# 의미 라우터가 기억 필요성을 놓쳐도 무도구 대화에는 후보 상한을 낮춘
# 얕은 검색을 1회 수행합니다. 관련도 임계값을 넘은 기억만 사용합니다.
RAG_PASSIVE_NO_TOOL_SEARCH_ENABLED=true

# ----------------------------------------------------
# 4. 이미지 생성 모델 (CometAPI Gemini native)
# ----------------------------------------------------
COMETAPI_IMAGE_ENABLED=true
COMETAPI_IMAGE_API_KEY=${COMETAPI_KEY}
# Gemini native endpoint는 /v1을 붙이지 않은 API root를 사용합니다.
COMETAPI_IMAGE_BASE_URL=https://api.cometapi.com
IMAGE_MODEL=gemini-3.1-flash-lite-image
IMAGE_ASPECT_RATIO=1:1
IMAGE_GLOBAL_DAILY_LIMIT=50
IMAGE_GUILD_DAILY_LIMIT=30
IMAGE_USER_LIMIT=10
IMAGE_USER_RESET_HOURS=6
# 다른 이미지가 생성 중이면 추가 API 호출 없이 이 시간까지 순서를 기다립니다.
IMAGE_GENERATION_QUEUE_TIMEOUT_SECONDS=30
# 전송 원문은 먼저 저장하고 로컬 임베딩은 잠시 뒤 백그라운드에서 시작합니다.
ASSISTANT_MEMORY_EMBEDDING_DELAY_SECONDS=2
# ----------------------------------------------------
# 5. 날씨 및 기타 통합 API
# ----------------------------------------------------
KMA_API_KEY=your_kma_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
KAKAO_API_KEY=your_kakao_api_key_here
GOOGLE_CX=your_google_cx_here
TOOL_CIRCUIT_FAILURE_THRESHOLD=2
TOOL_CIRCUIT_COOLDOWN_SECONDS=60

# ----------------------------------------------------
# 6. Database Server Setup (External DB / TiDB)
# ----------------------------------------------------
MASAMONG_DB_BACKEND=tidb
MASAMONG_DB_HOST=your_db_host_here
MASAMONG_DB_PORT=4000
MASAMONG_DB_NAME=masamong
MASAMONG_EXPECTED_DB_NAME=masamong
MASAMONG_DB_USER=your_db_user_here
MASAMONG_DB_PASSWORD=your_db_password_here
MASAMONG_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MASAMONG_DB_SSL_VERIFY_IDENTITY=true
MASAMONG_DB_REQUIRE_TLS=true
MASAMONG_DB_STRICT_REMOTE_ONLY=true

MASAMONG_DB_CONN_MAX_LIFETIME_SECONDS=600
MASAMONG_DB_CONNECT_TIMEOUT=10
MASAMONG_DB_READ_TIMEOUT=30
MASAMONG_DB_WRITE_TIMEOUT=30
TIDB_STARTER_FREE_PLAN_MODE=true
TIDB_STARTER_USAGE_WARNING_RATIO=0.8

DISCORD_EMBEDDING_BACKEND=tidb
KAKAO_STORE_BACKEND=tidb
DISCORD_EMBEDDING_TIDB_TABLE=discord_chat_embeddings
KAKAO_TIDB_TABLE=kakao_chunks

# ----------------------------------------------------
# 7. 기타 설정
# ----------------------------------------------------

# 봇 언어 설정 (프로필 고정)
# 지원 언어: ko (한국어), en (English), ja (日本語)
MASAMONG_LANG=ko

LOCAL_EMBEDDING_LOCAL_FILES_ONLY=true
RAG_ARCHIVE_RUN_ON_STARTUP=false
RAG_ARCHIVE_STARTUP_DELAY_SECONDS=120
# 저사양 운영에서는 로컬 FTS5 인덱스 생성·재구축을 사용하지 않습니다.
BM25_AUTO_REBUILD_ENABLED=false

EMB_CONFIG_PATH=emb_config.json
PROMPT_CONFIG_PATH=prompts.json

STRUCTURED_MEMORY_QUERY_LIMIT=384
STRUCTURED_MEMORY_FALLBACK_QUERY_LIMIT=768
STRUCTURED_MEMORY_SIMILARITY_THRESHOLD=0.5
# 순수 의미 유사도 기준. 개인/어휘 보너스는 순위에만 쓰며 이 관문을 우회하지 못함.
RAG_MEMORY_GATE_SCORE=0.61
RAG_EXPLICIT_MEMORY_GATE_SCORE=0.58
RAG_MEMORY_RELATIVE_FLOOR=0.94
# 원문이 없는 후보는 0.93, 원문 ID가 겹치는 이웃 윈도우는 0.80부터 중복 처리.
RAG_MEMORY_DEDUPE_SIMILARITY=0.93
RAG_MEMORY_DEDUPE_OVERLAP_SIMILARITY=0.80
# 벡터가 없는 Kakao 후보의 3-gram 자카드 fallback 기준.
RAG_MEMORY_DEDUPE_SHINGLE=0.55
RAG_SOURCE_DIVERSITY_ENABLED=true
RAG_SOURCE_DIVERSITY_RELATIVE_FLOOR=0.72
RAG_SOURCE_DIVERSITY_LEXICAL_FLOOR=0.02
RAG_MEMORY_MAX_BLOCKS=3
# embedding_vec 열 추가·전체 백필·검증이 끝난 인스턴스에서만 true.
STRUCTURED_MEMORY_VECTOR_SEARCH_ENABLED=false
STRUCTURED_MEMORY_VECTOR_TOP_K=32
