MASAMONG_PROFILE=general
MASAMONG_INSTANCE_NAME=general
MASAMONG_REQUIRE_EXPLICIT_PROFILE=true
MASAMONG_ENV_FILE=tests/fixtures/test.env
MASAMONG_CONFIG_FILE=tests/fixtures/config.test.json
MASAMONG_LOG_FILE=/dev/null
MASAMONG_ERROR_LOG_FILE=/dev/null
MASAMONG_ANALYTICS_STORE_CONTENT=false
MASAMONG_AUTO_MIGRATE=true
DISCORD_BOT_TOKEN=test-token
MASAMONG_EXPECTED_DISCORD_BOT_USER_ID=123456789012345678
MASAMONG_DB_BACKEND=sqlite
MASAMONG_DATABASE_FILE=/tmp/masamong-tests/general/main.db
MASAMONG_DB_STRICT_REMOTE_ONLY=false
MASAMONG_MEMORY_SOURCES=discord
DISCORD_EMBEDDING_BACKEND=sqlite
KAKAO_STORE_BACKEND=local
EMB_CONFIG_PATH=tests/fixtures/emb.test.json
PROMPT_CONFIG_PATH=prompts.example.json
LOCAL_EMBEDDING_LOCAL_FILES_ONLY=true
AI_MEMORY_ENABLED=false
EMBEDDING_ENABLED=false
RERANK_ENABLED=false
AI_MAX_CONCURRENT_PROCESSING=1
EMBEDDING_MAX_CONCURRENCY=1
RAG_MAX_BACKGROUND_TASKS=2
SCHOOL_NOTICE_ENABLED=false
TRANSFER_NOTICE_ENABLED=false
# 명시적 프로필은 켜 둔 기능의 자격증명을 기동 시점에 요구한다.
# 아래 값은 실제 호출에 쓰이지 않는 테스트용 더미다.
COMETAPI_KEY=test-cometapi-key
KMA_API_KEY=test-kma-key
GEMINI_API_KEY=
# 비워 두면 WEB_SEARCH_PROVIDER가 legacy로 정해져 Linkup key를 요구하지 않는다.
LINKUP_API_KEY=
