# DO NOT replace the current production env with this shortened example.
# Copy the exact current env first, verify its key set/hash, then add the boundary keys below.
# Existing production ownership: keep the current token, DB, model and CPU values unchanged.
MASAMONG_PROFILE=masamo
MASAMONG_INSTANCE_NAME=masamo
MASAMONG_REQUIRE_EXPLICIT_PROFILE=true
MASAMONG_ENV_FILE=/etc/masamong/masamo.env
MASAMONG_CONFIG_FILE=/etc/masamong/masamo/config.json
MASAMONG_REQUIRED_COGS=tools_cog,events,ai_handler
# First profile-only restart must not perform DDL/backfill/reseeding.
MASAMONG_AUTO_MIGRATE=false
# Preserve the old static prompts until stale guild_settings have been audited.
MASAMONG_GUILD_SETTINGS_MODE=static

DISCORD_BOT_TOKEN=replace-with-current-masamo-token
MASAMONG_EXPECTED_DISCORD_BOT_USER_ID=replace-with-current-masamo-bot-user-id
MASAMONG_COMMAND_PREFIX=!
# Masamo 전용 최고 관리자. 실제 Discord 사용자 ID는 운영 env에만 넣고
# General 프로필이나 Git 추적 예제에 복사하지 않는다.
MASAMONG_SUPERADMIN_USER_IDS=replace-with-current-masamo-superadmin-user-id

MASAMONG_DB_BACKEND=tidb
MASAMONG_DB_HOST=replace-with-current-host
MASAMONG_DB_PORT=4000
MASAMONG_DB_NAME=masamong
MASAMONG_EXPECTED_DB_NAME=masamong
MASAMONG_DB_USER=replace-with-current-masamo-db-user
MASAMONG_DB_PASSWORD=replace-with-current-password
MASAMONG_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MASAMONG_DB_SSL_VERIFY_IDENTITY=true
MASAMONG_DB_REQUIRE_TLS=true
MASAMONG_DB_STRICT_REMOTE_ONLY=true
# TiDB Cloud Starter 무료 한도(행 5GiB/열 5GiB/월 5천만 RU) 보호.
TIDB_STARTER_FREE_PLAN_MODE=true
TIDB_STARTER_USAGE_WARNING_RATIO=0.8

MASAMONG_MEMORY_SOURCES=discord,kakao
DISCORD_EMBEDDING_BACKEND=tidb
KAKAO_STORE_BACKEND=tidb
DISCORD_EMBEDDING_TIDB_TABLE=discord_chat_embeddings
KAKAO_TIDB_TABLE=kakao_chunks
EMB_CONFIG_PATH=/etc/masamong/masamo/emb_config.json
PROMPT_CONFIG_PATH=/etc/masamong/masamo/prompts.json

MASAMONG_LOG_FILE=/var/log/masamong/masamo.log
MASAMONG_ERROR_LOG_FILE=/var/log/masamong/masamo-error.log
MASAMONG_OPERATIONS_LOG_CHANNEL_ID=0
MASAMONG_ANALYTICS_STORE_CONTENT=false

# Before the first profile restart, replace these numeric examples with the
# exact values captured from the current low-spec service. Do not omit them:
# explicit profiles intentionally ignore inherited MASAMONG_* service values.
MASAMONG_CPU_THREADS=1
MASAMONG_EXECUTOR_WORKERS=1
AI_MAX_CONCURRENT_PROCESSING=1
AI_QUEUE_WAIT_TIMEOUT_SECONDS=5
LLM_MAX_CONCURRENT_CALLS=1
LLM_ACQUIRE_TIMEOUT_SECONDS=10
LLM_CALL_TIMEOUT_SECONDS=120
EMBEDDING_MAX_CONCURRENCY=1
RAG_MAX_BACKGROUND_TASKS=8
RAG_MAX_TRACKED_WINDOWS=256
# Masamo 원격 서버는 저사양이므로 BM25/FTS5 구축 작업을 절대 시작하지 않는다.
BM25_AUTO_REBUILD_ENABLED=false
KAKAO_API_MAX_CONCURRENCY=1
TOOL_CIRCUIT_FAILURE_THRESHOLD=2
TOOL_CIRCUIT_COOLDOWN_SECONDS=60
MASAMONG_DISCORD_MAX_MESSAGES=200
EARTHQUAKE_CHECK_INTERVAL_SECONDS=60
EARTHQUAKE_SEQUENCE_WINDOW_HOURS=72
EARTHQUAKE_SEQUENCE_RADIUS_KM=150
EARTHQUAKE_SEQUENCE_MAX_DISPLAY_EVENTS=6
TOKENIZERS_PARALLELISM=false
FORTUNE_MORNING_MAX_GENERATION_ATTEMPTS=3
FORTUNE_MORNING_MAX_SEND_ATTEMPTS=3
FORTUNE_MORNING_RETRY_BASE_SECONDS=60
FORTUNE_MORNING_LLM_TIMEOUT_SECONDS=35
FORTUNE_MORNING_SEND_TIMEOUT_SECONDS=10

# 학교 공지 추적. 수집은 별도 oneshot timer가 담당하며 봇 프로세스는
# 사용자 설정·결과 전달만 수행한다. 모든 가변 경로는 Masamo 전용이다.
SCHOOL_NOTICE_ENABLED=true
SCHOOL_NOTICE_DIGEST_DIR=/var/lib/masamong/masamo/notice/out
SCHOOL_NOTICE_CORE_DB=/var/lib/masamong/masamo/notice/core.db
SCHOOL_NOTICE_CATALOG_PATH=/srv/masamong/current/profiles/catalogs/school_notice_catalog.v1.json
SCHOOL_NOTICE_SOURCE_CONFIG=/srv/masamong/current/school_notice/sources.json
SCHOOL_NOTICE_DELIVERY_HOUR=9
SCHOOL_NOTICE_DELIVERY_MINUTE=0
SCHOOL_NOTICE_MAX_ITEMS_PER_DM=10
SCHOOL_NOTICE_SCHEMA_VERSION=1
SCHOOL_NOTICE_STALE_WARNING_ENABLED=false
SCHOOL_NOTICE_PROFILE_LLM_ENABLED=true
SCHOOL_NOTICE_PROFILE_MAX_REVISIONS=3
SCHOOL_NOTICE_PROFILE_INPUT_TIMEOUT_SECONDS=120
SCHOOL_NOTICE_PROFILE_LLM_TIMEOUT_SECONDS=20
SCHOOL_NOTICE_INITIAL_CRAWL_ENABLED=true
SCHOOL_NOTICE_INITIAL_CRAWL_TIMEOUT_SECONDS=660
SCHOOL_NOTICE_INITIAL_CRAWL_MAX_ATTEMPTS=2
SCHOOL_NOTICE_INITIAL_CRAWL_RETRY_SECONDS=20
SCHOOL_NOTICE_DELIVERY_BATCH_SIZE=5
SCHOOL_NOTICE_DELIVERY_MAX_ATTEMPTS=3
SCHOOL_NOTICE_DELIVERY_RETRY_MINUTES=10
SCHOOL_NOTICE_DELIVERY_USER_TIMEOUT_SECONDS=30
SCHOOL_NOTICE_BATCH_MAX_PROFILES=20
SCHOOL_NOTICE_BATCH_PROFILE_TIMEOUT_SECONDS=600
SCHOOL_NOTICE_BATCH_FEEDBACK_TIMEOUT_SECONDS=60
SCHOOL_NOTICE_BATCH_TOTAL_TIMEOUT_SECONDS=1800

# 공인영어(TOEIC 포함) 편입 공지. 공개 수집과 개인 DM 구독을 Masamo가 소유한다.
TRANSFER_NOTICE_ENABLED=true
TRANSFER_NOTICE_SOURCE_CONFIG=/srv/masamong/current/transfer_notice/sources.json
TRANSFER_NOTICE_DATABASE=/var/lib/masamong/masamo/transfer_notice/core.db
TRANSFER_NOTICE_OUTPUT_DIR=/var/lib/masamong/masamo/transfer_notice/out
TRANSFER_NOTICE_DELIVERY_MAX_ATTEMPTS=3
TRANSFER_NOTICE_DELIVERY_RETRY_MINUTES=30
TRANSFER_NOTICE_MAX_ITEMS_PER_DM=10
TRANSFER_NOTICE_DELIVERY_HOUR=9
TRANSFER_NOTICE_DELIVERY_MINUTE=0

# Keep every existing LLM/search/weather/RAG key below without changing its value.
# These are required at startup for any feature left enabled. An explicit profile
# reads only this file, so a key that currently lives in systemd Environment= or
# the shell disappears on switchover. Copy the real current values here.
COMETAPI_KEY=replace-with-current-masamo-key
LLM_MAIN_PRIMARY_PROVIDER=openai_compat
LLM_MAIN_PRIMARY_MODEL=deepseek-v4-flash
LLM_MAIN_PRIMARY_BASE_URL=https://api.cometapi.com/v1
LLM_MAIN_PRIMARY_API_KEY=${COMETAPI_KEY}
LLM_MAIN_FALLBACK_PROVIDER=none
LLM_ROUTING_PRIMARY_PROVIDER=openai_compat
LLM_ROUTING_PRIMARY_MODEL=gpt-5.4-nano
SEMANTIC_ROUTER_MAX_TOKENS=384
SEMANTIC_ROUTER_COMPACTION_MAX_TOKENS=768
LLM_ROUTING_PRIMARY_BASE_URL=https://api.cometapi.com/v1
LLM_ROUTING_PRIMARY_API_KEY=${COMETAPI_KEY}
COMETAPI_RPM_LIMIT=40
COMETAPI_RPD_LIMIT=3000
LLM_GUILD_RPM_LIMIT=30
LLM_GUILD_RPD_LIMIT=2000
LLM_DM_RPM_LIMIT=20
LLM_DM_RPD_LIMIT=1000
LLM_USER_RPM_LIMIT=12
LLM_USER_RPD_LIMIT=300
LLM_DM_USER_RPM_LIMIT=8
LLM_DM_USER_RPD_LIMIT=120
LLM_FEATURE_RPM_LIMIT=35
LLM_FEATURE_RPD_LIMIT=2500
FORTUNE_MODEL_LITE=deepseek-v4-flash
FORTUNE_MODEL_PRO=deepseek-v4-pro
SCHOOL_NOTICE_LLM_BASE_URL=https://api.cometapi.com/v1
SCHOOL_NOTICE_LLM_MODEL=deepseek-v4-flash
COMETAPI_IMAGE_ENABLED=true
COMETAPI_IMAGE_API_KEY=${COMETAPI_KEY}
COMETAPI_IMAGE_BASE_URL=https://api.cometapi.com
IMAGE_MODEL=gemini-3.1-flash-lite-image
IMAGE_GLOBAL_DAILY_LIMIT=50
IMAGE_GUILD_DAILY_LIMIT=30
IMAGE_USER_LIMIT=10
KMA_API_KEY=replace-with-current-masamo-key
KMA_API_DAILY_CALL_LIMIT=10000
KMA_API_MAX_RETRIES=2
KMA_URGENT_API_MAX_RETRIES=1
KMA_API_RETRY_DELAY_SECONDS=1
KMA_API_TIMEOUT=10
# Only needed when WEB_SEARCH_PROVIDER=linkup and LINKUP_ENABLED=true.
LINKUP_API_KEY=replace-with-current-masamo-key
LINKUP_FETCH_RENDER_JS=false
LINKUP_FETCH_JS_RETRY_ENABLED=true
WEB_SEARCH_GLOBAL_RPM_LIMIT=20
WEB_SEARCH_GLOBAL_RPD_LIMIT=1000
WEB_SEARCH_GUILD_RPM_LIMIT=10
WEB_SEARCH_GUILD_RPD_LIMIT=300
WEB_SEARCH_USER_RPM_LIMIT=4
WEB_SEARCH_USER_RPD_LIMIT=60
STRUCTURED_MEMORY_QUERY_LIMIT=384
STRUCTURED_MEMORY_FALLBACK_QUERY_LIMIT=768
# If an instance genuinely has no weather key, drop the Cog instead of shipping
# a bot whose weather commands fail only when a user runs them:
# MASAMONG_DISABLED_COGS=weather_cog
