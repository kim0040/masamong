# New isolated instance: use a different Discord application and a new empty DB.
MASAMONG_PROFILE=general
MASAMONG_INSTANCE_NAME=general
MASAMONG_REQUIRE_EXPLICIT_PROFILE=true
MASAMONG_ENV_FILE=/etc/masamong/general.env
MASAMONG_CONFIG_FILE=/etc/masamong/general/config.json
MASAMONG_REQUIRED_COGS=tools_cog,events,ai_handler
# 정상 운영 기본값. 완전히 새 빈 General DB를 최초 bootstrap할 때만 문서를
# 확인하고 일시적으로 true로 바꾼 뒤 schema 검증 직후 다시 false로 되돌린다.
MASAMONG_AUTO_MIGRATE=false
MASAMONG_GUILD_SETTINGS_MODE=database

DISCORD_BOT_TOKEN=replace-with-new-general-token
MASAMONG_EXPECTED_DISCORD_BOT_USER_ID=replace-with-new-general-bot-user-id
# Keep a different prefix if both bots can ever share a Discord guild.
MASAMONG_COMMAND_PREFIX=?

MASAMONG_DB_BACKEND=tidb
MASAMONG_DB_HOST=replace-with-db-host
MASAMONG_DB_PORT=4000
MASAMONG_DB_NAME=masamong_general
MASAMONG_EXPECTED_DB_NAME=masamong_general
MASAMONG_DB_USER=replace-with-general-only-db-user
MASAMONG_DB_PASSWORD=replace-with-password
MASAMONG_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MASAMONG_DB_SSL_VERIFY_IDENTITY=true
MASAMONG_DB_REQUIRE_TLS=true
MASAMONG_DB_STRICT_REMOTE_ONLY=true

# General must not construct or query the Masamo Kakao memory store.
MASAMONG_MEMORY_SOURCES=discord
DISCORD_EMBEDDING_BACKEND=tidb
KAKAO_STORE_BACKEND=tidb
DISCORD_EMBEDDING_TIDB_TABLE=discord_chat_embeddings
KAKAO_TIDB_TABLE=kakao_chunks
EMB_CONFIG_PATH=/etc/masamong/general/emb_config.json
PROMPT_CONFIG_PATH=/etc/masamong/general/prompts.json

MASAMONG_LOG_FILE=/var/log/masamong/general.log
MASAMONG_ERROR_LOG_FILE=/var/log/masamong/general-error.log
MASAMONG_OPERATIONS_LOG_CHANNEL_ID=0
MASAMONG_ANALYTICS_STORE_CONTENT=false

# Start without local RAG on the low-spec server, then enable only after measurement.
AI_MEMORY_ENABLED=false
EMBEDDING_ENABLED=false
RERANK_ENABLED=false
RAG_ARCHIVING_ENABLED=false
BM25_AUTO_REBUILD_ENABLED=false
MASAMONG_CPU_THREADS=1
MASAMONG_EXECUTOR_WORKERS=1
AI_MAX_CONCURRENT_PROCESSING=1
AI_QUEUE_WAIT_TIMEOUT_SECONDS=5
LLM_MAX_CONCURRENT_CALLS=1
LLM_ACQUIRE_TIMEOUT_SECONDS=10
LLM_CALL_TIMEOUT_SECONDS=120
EMBEDDING_MAX_CONCURRENCY=1
RAG_MAX_BACKGROUND_TASKS=2
RAG_MAX_TRACKED_WINDOWS=64
MASAMONG_DISCORD_MAX_MESSAGES=100
TOKENIZERS_PARALLELISM=false

# General owns no scheduled community notifications during the first rollout.
ENABLE_RAIN_NOTIFICATION=false
ENABLE_GREETING_NOTIFICATION=false
ENABLE_EARTHQUAKE_ALERT=false
EARTHQUAKE_SEQUENCE_WINDOW_HOURS=72
EARTHQUAKE_SEQUENCE_RADIUS_KM=150
EARTHQUAKE_SEQUENCE_MAX_DISPLAY_EVENTS=6
FORTUNE_MORNING_BRIEFING_ENABLED=false
FORTUNE_MORNING_MAX_GENERATION_ATTEMPTS=3
FORTUNE_MORNING_MAX_SEND_ATTEMPTS=3
FORTUNE_MORNING_RETRY_BASE_SECONDS=60
FORTUNE_MORNING_LLM_TIMEOUT_SECONDS=35
FORTUNE_MORNING_SEND_TIMEOUT_SECONDS=10

# Prefer separate provider keys/budgets where possible.
COMETAPI_KEY=replace-with-general-key
GEMINI_API_KEY=
LINKUP_API_KEY=replace-with-general-key
KMA_API_KEY=replace-with-key
KMA_API_DAILY_CALL_LIMIT=10000
KMA_API_MAX_RETRIES=2
KMA_URGENT_API_MAX_RETRIES=1
KMA_API_RETRY_DELAY_SECONDS=1
KMA_API_TIMEOUT=10

# 학교 공지 추적. 수집은 systemd timer가 별도 프로세스로 실행하고
# 봇은 결과 digest만 읽어 전달한다(봇 프로세스에서 크롤링하지 않음).
# true로 켜면 모든 경로가 절대 경로여야 하며, 아니면 기동에 실패한다.
SCHOOL_NOTICE_ENABLED=false
SCHOOL_NOTICE_DIGEST_DIR=/var/lib/masamong/general/notice/out
SCHOOL_NOTICE_CORE_DB=/var/lib/masamong/general/notice/core.db
SCHOOL_NOTICE_CATALOG_PATH=/srv/masamong/current/profiles/catalogs/school_notice_catalog.v1.json
SCHOOL_NOTICE_SOURCE_CONFIG=/srv/masamong/current/school_notice/sources.json
# versioned systemd timer가 매일 23:00 KST에 수집한다.
# 프로필 D의 결과는 D+1 사용자 시각에 보낸다.
# 신규 사용자의 기본값이며, 이후에는 `!공지 시간 HH:MM` 값이 적용된다.
SCHOOL_NOTICE_DELIVERY_HOUR=9
SCHOOL_NOTICE_DELIVERY_MINUTE=0
SCHOOL_NOTICE_MAX_ITEMS_PER_DM=10
SCHOOL_NOTICE_SCHEMA_VERSION=1
SCHOOL_NOTICE_STALE_WARNING_ENABLED=false
SCHOOL_NOTICE_PROFILE_LLM_ENABLED=true
SCHOOL_NOTICE_PROFILE_MAX_REVISIONS=3
SCHOOL_NOTICE_PROFILE_INPUT_TIMEOUT_SECONDS=120
SCHOOL_NOTICE_PROFILE_LLM_TIMEOUT_SECONDS=20
SCHOOL_NOTICE_DELIVERY_BATCH_SIZE=10
SCHOOL_NOTICE_DELIVERY_MAX_ATTEMPTS=3
SCHOOL_NOTICE_DELIVERY_RETRY_MINUTES=10
SCHOOL_NOTICE_DELIVERY_USER_TIMEOUT_SECONDS=30
SCHOOL_NOTICE_BATCH_MAX_PROFILES=50
SCHOOL_NOTICE_BATCH_PROFILE_TIMEOUT_SECONDS=600
SCHOOL_NOTICE_BATCH_FEEDBACK_TIMEOUT_SECONDS=60
SCHOOL_NOTICE_BATCH_TOTAL_TIMEOUT_SECONDS=1800
